// Prisma Schema for FUAB-CR (Course Registration & Results Management System)
// Configured with SQLite for seamless local dev & PostgreSQL compatibility

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Faculty {
  id          String       @id @default(uuid())
  name        String       @unique
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id               String            @id @default(uuid())
  name             String
  facultyId        String
  faculty          Faculty           @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  courses          Course[]
  students         Student[]
  preloadedMatrics PreloadedMatric[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([name, facultyId])
}

model Course {
  id           String                     @id @default(uuid())
  code         String                     @unique
  title        String
  unit         Int
  level        Int                        // e.g. 100, 200, 300, 400
  semester     String                     // e.g. "First", "Second"
  departmentId String
  department   Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignments  LecturerCourseAssignment[]
  registrations CourseRegistration[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

model Student {
  id                   String               @id @default(uuid())
  matricNumber         String               @unique
  fullName             String
  departmentId         String
  department           Department           @relation(fields: [departmentId], references: [id])
  level                Int
  passwordHash         String?
  isRegisteredOnPortal Boolean              @default(false)
  isLocked             Boolean              @default(false)
  registrations        CourseRegistration[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model PreloadedMatric {
  id           String     @id @default(uuid())
  matricNumber String     @unique
  fullName     String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  level        Int
  createdAt    DateTime   @default(now())
}

model Lecturer {
  id            String                     @id @default(uuid())
  fullName      String
  email         String                     @unique
  passwordHash   String
  assignments   LecturerCourseAssignment[]
  enteredScores Score[]                    @relation("LecturerEnteredScores")
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
}

model LecturerCourseAssignment {
  id         String   @id @default(uuid())
  lecturerId String
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session    String   // e.g. "2025/2026"
  createdAt  DateTime @default(now())

  @@unique([lecturerId, courseId, session])
}

model CourseRegistration {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session   String   // e.g. "2025/2026"
  semester  String   // e.g. "First" or "Second"
  status    String   @default("registered") // "registered", "scored", "approved"
  score     Score?
  createdAt DateTime @default(now())

  @@unique([studentId, courseId, session, semester])
}

model Score {
  id                   String             @id @default(uuid())
  courseRegistrationId String             @unique
  courseRegistration   CourseRegistration @relation(fields: [courseRegistrationId], references: [id], onDelete: Cascade)
  caScore              Float
  examScore            Float
  totalScore           Float
  grade                String?            // e.g. A, B, C, D, F
  gradePoint           Float?             // e.g. 5.0, 4.0, 3.0, 2.0, 0.0
  enteredByLecturerId  String
  enteredByLecturer    Lecturer           @relation("LecturerEnteredScores", fields: [enteredByLecturerId], references: [id])
  enteredAt            DateTime           @default(now())
  approvedByManagement Boolean            @default(false)
  approvedAt           DateTime?
  policySnapshot       String?            // JSON string snapshot of GradingPolicy
}

model GradingPolicy {
  id                String   @id @default(uuid())
  session           String   @unique
  caWeightPercent   Float
  examWeightPercent  Float
  gradeBoundaries   String   // JSON string of grade boundaries and points
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ManagementAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
